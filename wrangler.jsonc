{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainspace",
  "account_id": "89a183283adca0be757d766579cef70c",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/server.ts",
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [
    { "pattern": "usebrain.space", "custom_domain": true },
    { "pattern": "www.usebrain.space", "custom_domain": true }
  ],
  "vars": {
    "APP_URL": "https://usebrain.space",
    "EMAIL_FROM": "Brainspace <hello@usebrain.space>",
    // Where new sign-ups are posted: #niths-crap (needs the SLACK_BOT_TOKEN secret).
    // Set ALLOWED_EMAIL_DOMAINS (comma-separated) to only let those domains sign in.
    "SLACK_ALERT_CHANNEL": "C0BNGV1QBTL"
  },
  // Sign-in emails: at most 3 a minute to one address and 5 a minute from one IP.
  "ratelimits": [
    { "name": "MAGIC_LINK_EMAIL_LIMIT", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "MAGIC_LINK_IP_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainspace",
      "database_id": "52d548c8-962a-4aee-9251-9396949fc757",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "brainspace-files" }],
  "vectorize": [{ "binding": "VECTORS", "index_name": "brainspace-chunks", "remote": true }],
  "ai": { "binding": "AI", "remote": true },
  // Headless Chrome for brain.pdf() in flows (src/server/services/pdf.ts).
  "browser": { "binding": "BROWSER", "remote": true },
  "durable_objects": {
    "bindings": [
      { "name": "LIVE", "class_name": "WorkspaceLive" },
      // Folder databases: one SQLite database per object, named by its node id.
      { "name": "DATABASES", "class_name": "BrainDatabase" },
      // Bots: one agent (Cloudflare Agents SDK) per bot, named by the bot's id.
      // Its subagents (BrainBotWorker) are children of it and need no binding.
      { "name": "BOTS", "class_name": "BrainBot" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["WorkspaceLive"] },
    { "tag": "v2", "new_sqlite_classes": ["BrainDatabase"] },
    { "tag": "v3", "new_sqlite_classes": ["BrainBot"] }
  ],
  // Flows: agent-written code, loaded at runtime into sandboxed Dynamic Workers
  // and run durably by one Workflow class (see docs/design/flows.md).
  "worker_loaders": [{ "binding": "LOADER" }],
  "workflows": [{ "name": "brainspace-flows", "binding": "FLOWS", "class_name": "FlowWorkflow" }],
  "triggers": { "crons": ["* * * * *"] },
  "queues": {
    "producers": [{ "binding": "EXTRACT_QUEUE", "queue": "brainspace-extract" }],
    "consumers": [
      {
        "queue": "brainspace-extract",
        "max_batch_size": 1,
        "max_retries": 4,
        "dead_letter_queue": "brainspace-extract-dlq"
      }
    ]
  }
}
